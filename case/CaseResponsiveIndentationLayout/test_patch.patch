@@ -0,0 +1,89 @@
+import { describe, beforeAll, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import abilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import Want from '@ohos.app.ability.Want';
+
+const delegator = abilityDelegatorRegistry.getAbilityDelegator();
+
+async function startAbility(driver: Driver, bundleName: string, abilityName: string) {
+  let want: Want = {
+    bundleName: bundleName,
+    abilityName: abilityName
+  };
+  await delegator.startAbility(want);
+  await driver.delayMs(1000);
+}
+
+export default function CommonPassToPassTest() {
+  describe('CommonPassToPassTest', () => {
+
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      try {
+        driver = Driver.create();
+        bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+        await startAbility(driver, bundleName, 'EntryAbility');
+      } catch (e) {
+        console.error('CommonPassToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_start_setting_page_successfully', 0, async (done: Function) => {
+      let scrollContainer = await driver.findComponent(ON.id('setting-page-scroll'));
+      expect(scrollContainer !== null).assertTrue();
+      done();
+    });
+
+    it('should_show_reading_content', 0, async (done: Function) => {
+      let indentTitle = await driver.findComponent(ON.text('设置'));
+      let readingCard0 = await driver.findComponent(ON.text('个人信息'));
+      let readingCard1 = await driver.findComponent(ON.text('字体大小'));
+
+      expect(indentTitle !== null).assertTrue();
+      expect(readingCard0 !== null).assertTrue();
+      expect(readingCard1 !== null).assertTrue();
+      done();
+    });
+
+    it('should_show_setting_form_content', 0, async (done: Function) => {
+      let notifySwitch = await driver.findComponent(ON.text('通知开关'));
+      let recommendSwitch = await driver.findComponent(ON.text('个性化推荐'));
+      expect(notifySwitch !== null).assertTrue();
+      expect(recommendSwitch !== null).assertTrue();
+
+      let toggles = await driver.findComponents(ON.type('Toggle'));
+      expect(toggles.length).assertLarger(0);
+
+      let displayMode = await driver.findComponent(ON.text('显示模式'));
+      expect(displayMode !== null).assertTrue();
+      let defaultSelectValue = await driver.findComponent(ON.text('跟随系统'));
+      expect(defaultSelectValue !== null).assertTrue();
+      done();
+    });
+
+    it('should_keep_setting_page_scrollable', 0, async (done: Function) => {
+      let scrollContainer = await driver.findComponent(ON.id('setting-page-scroll'));
+      expect(scrollContainer !== null).assertTrue();
+
+      let bounds = await scrollContainer.getBounds();
+      let centerX = (bounds.left + bounds.right) / 2;
+      let startY = bounds.bottom - 100;
+      let endY = bounds.top + 100;
+      await driver.swipe(
+        Math.round(centerX),
+        Math.round(startY),
+        Math.round(centerX),
+        Math.round(endY)
+      );
+      await driver.delayMs(1000);
+
+      let group5Title = await driver.findComponent(ON.text('了解我们如何使用您的数据'));
+      let lastItem = await driver.findComponent(ON.text('隐私声明摘要'));
+      expect(group5Title !== null).assertTrue();
+      expect(lastItem !== null).assertTrue();
+      done();
+    });
+  });
+}
diff --git a/entry/src/ohosTest/ets/test/LgFailToPass.test.ets b/entry/src/ohosTest/ets/test/LgFailToPass.test.ets
new file mode 100644
index 0000000..37def89
--- /dev/null
+++ b/entry/src/ohosTest/ets/test/LgFailToPass.test.ets
@@ -0,0 +1,90 @@
+import { describe, beforeAll, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import abilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import Want from '@ohos.app.ability.Want';
+import display from '@ohos.display';
+
+const delegator = abilityDelegatorRegistry.getAbilityDelegator();
+
+async function startAbility(driver: Driver, bundleName: string, abilityName: string) {
+  let want: Want = {
+    bundleName: bundleName,
+    abilityName: abilityName
+  };
+  await delegator.startAbility(want);
+  await driver.delayMs(1000);
+}
+
+function isLargeBreakpoint(): boolean {
+  let displayInfo = display.getDefaultDisplaySync();
+  let widthVp = displayInfo.width / displayInfo.densityPixels;
+  return widthVp >= 840;
+}
+
+export default function LgFailToPassTest() {
+  describe('LgFailToPassTest', () => {
+
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      try {
+        driver = Driver.create();
+        bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+        await startAbility(driver, bundleName, 'EntryAbility');
+      } catch (e) {
+        console.error('LgFailToPass beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_center_single_column_content_on_large_breakpoint', 0, async (done: Function) => {
+      if (!isLargeBreakpoint()) {
+        expect(true).assertTrue();
+        done();
+        return;
+      }
+
+      let displayInfo = display.getDefaultDisplaySync();
+      let screenWidthPx = displayInfo.width;
+
+      let scrollContainer = await driver.findComponent(ON.type('Scroll'));
+      expect(scrollContainer !== null).assertTrue();
+
+      let scrollBounds = await scrollContainer.getBounds();
+      let leftGutterPx = scrollBounds.left;
+      let rightGutterPx = screenWidthPx - scrollBounds.right;
+
+      console.info(`[LgFailToPass] gutter: left=${leftGutterPx}px, right=${rightGutterPx}px, screen=${screenWidthPx}px`);
+
+      let minGutterThreshold = screenWidthPx * 0.12;
+      expect(leftGutterPx > minGutterThreshold).assertTrue();
+      expect(rightGutterPx > minGutterThreshold).assertTrue();
+
+      let diff = Math.abs(leftGutterPx - rightGutterPx);
+      expect(diff <= 8).assertTrue();
+      done();
+    });
+
+    it('should_keep_single_column_content_width_bounded_on_large_breakpoint', 0, async (done: Function) => {
+      if (!isLargeBreakpoint()) {
+        expect(true).assertTrue();
+        done();
+        return;
+      }
+
+      let displayInfo = display.getDefaultDisplaySync();
+      let screenWidthPx = displayInfo.width;
+
+      let scrollContainer = await driver.findComponent(ON.type('Scroll'));
+      expect(scrollContainer !== null).assertTrue();
+
+      let scrollBounds = await scrollContainer.getBounds();
+      let scrollWidthPx = scrollBounds.right - scrollBounds.left;
+
+      let ratio = scrollWidthPx / screenWidthPx;
+      console.info(`[LgFailToPass] width ratio: ${ratio}`);
+      expect(ratio <= 0.72).assertTrue();
+      done();
+    });
+  });
+}
