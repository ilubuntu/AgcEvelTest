+import { describe, it, expect, Level, beforeEach, afterEach } from '@ohos/hypium';
+import {  Driver, ON } from '@kit.TestKit';
+import {
+  startAbility, isSameNavBarColor, getMainWindow,
+  getNavBarRect,
+  CustomRect,
+  getBundleName,
+  getScreenHeight,
+} from './TestHelper';
+import {  window } from '@kit.ArkUI';
+
+export default function immersiveCommonPassToPassTest() {
+  describe('immersiveCommonPassToPassTest', () => {
+    let driver: Driver;
+    let win: window.Window;``
+
+    beforeEach(async () => {
+      try {
+        driver = Driver.create();
+        await startAbility(driver, getBundleName(), 'EntryAbility');
+        await driver.delayMs(2000);
+        win = await getMainWindow();
+      } catch (e) {
+        console.error('MineLikePageOrientationUI beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterEach(async () => {
+      try {
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+      } catch (e) {
+        console.error('MineLikePageOrientationUI afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_content_main_home_is_exist', Level.LEVEL2, async (done: Function) => {
+      await driver.waitForComponent(ON.type('Navigation'), 2000)
+
+      await driver.assertComponentExist(ON.text('首页'));
+      done();
+    });
+  });
+}
