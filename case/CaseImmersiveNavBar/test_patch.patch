+import { describe, it, expect, Level, beforeEach, afterEach } from '@ohos/hypium';
+import {  Driver, ON } from '@kit.TestKit';
+import {
+  startAbility, isSameNavBarColor, getMainWindow,
+  getNavBarRect,
+  CustomRect,
+  getBundleName,
+  getScreenHeight,
+  isTabVertical,
+} from './TestHelper';
+import {  window } from '@kit.ArkUI';
+
+export default function immersiveNavBarFailToPassTest() {
+  describe('immersiveNavBarFailToPassTest', () => {
+    let driver: Driver;
+    let win: window.Window;``
+
+    beforeEach(async () => {
+      try {
+        driver = Driver.create();
+        await startAbility(driver, getBundleName(), 'EntryAbility');
+        await driver.delayMs(3000);
+        win = await getMainWindow();
+      } catch (e) {
+        console.error('MineLikePageOrientationUI beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterEach(async () => {
+      try {
+        await driver.waitForIdle(2000, 3000);
+        await driver.pressBack();
+      } catch (e) {
+        console.error('MineLikePageOrientationUI afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_content_area_not_overlap_nav_bar', Level.LEVEL2, async (done: Function) => {
+      try {
+        await driver.waitForComponent(ON.type('Navigation'), 3000)
+
+        // 获取状态栏的RectInfo
+        const navBarRectInfo: CustomRect = getNavBarRect(win);
+        const tabBar = await driver.findComponent(ON.type('TabBar'));
+
+        let tabBarBtm = (await tabBar.getBounds()).bottom;
+
+        // tabBar的bottom 需要小于等于导航栏的top
+        if (!isTabVertical()) {
+          expect(tabBarBtm).assertLessOrEqual(navBarRectInfo.top);
+        }
+
+        // 判断对应坐标的背景色
+        let result = await isSameNavBarColor(driver, navBarRectInfo.top);
+        expect(result).assertTrue();
+        done();
+      } catch (e) {
+        console.error('should_content_area_not_overlap_nav_bar error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+        done();
+      }
+    });
+  });
+}
+
