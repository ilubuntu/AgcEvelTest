diff --git a/commons/commons/src/main/ets/utils/WindowUtil.ets b/commons/commons/src/main/ets/utils/WindowUtil.ets
index 0d87d8a..3734674 100644
--- a/commons/commons/src/main/ets/utils/WindowUtil.ets
+++ b/commons/commons/src/main/ets/utils/WindowUtil.ets
@@ -61,6 +61,16 @@ export class WindowUtil {
       this.mainWindow.on('windowSizeChange', this.onWindowSizeChange);
 
       this.mainWindowInfo.titleButtonRect = this.mainWindow.getTitleButtonRect();
+
+      const navIndicatorArea =
+        this.mainWindow.getWindowAvoidArea(window.AvoidAreaType.TYPE_NAVIGATION_INDICATOR);
+      AppStorage.setOrCreate('avoidBottom', navIndicatorArea.bottomRect.height + 'px');
+
+      this.mainWindow.on('avoidAreaChange', (opts: window.AvoidAreaOptions) => {
+        if (opts.type === window.AvoidAreaType.TYPE_NAVIGATION_INDICATOR) {
+          AppStorage.setOrCreate('avoidBottom', opts.area.bottomRect.height + 'px');
+        }
+      });
     } catch (error) {
       let err = error as BusinessError;
       hilog.error(0x0000, `TestLog`, `Failed to update window info. Code: ${err.code}, message: ${err.message}`);
