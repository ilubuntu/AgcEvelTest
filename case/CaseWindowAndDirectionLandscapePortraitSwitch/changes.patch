+
+  /**
+   * 将方向策略应用到当前主窗口。
+   * 方向设置是窗口级全局副作用，调用方需在页面切换时负责重放各自页面的策略。
+   * @param orientation 目标方向策略
+   * @param fallback 主策略不被当前系统支持时的降级策略，可省略
+   */
+  static setMainWindowOrientation(orientation: Orientation, fallback?: Orientation): void {
+    try {
+      const windowStage = AppStorage.get('windowStage') as window.WindowStage;
+      if (!windowStage) {
+        Logger.warn(ORIENTATION_TAG, 'windowStage is not ready, skip setMainWindowOrientation.');
+        return;
+      }
+      const mainWindow = windowStage.getMainWindowSync();
+      mainWindow.setPreferredOrientation(orientation).catch((error: BusinessError) => {
+        if (fallback !== undefined) {
+          Logger.warn(ORIENTATION_TAG,
+            `setPreferredOrientation ${orientation} failed: ${JSON.stringify(error)}, fallback to ${fallback}`);
+          mainWindow.setPreferredOrientation(fallback).catch((fallbackError: BusinessError) => {
+            Logger.error(ORIENTATION_TAG, `fallback setPreferredOrientation failed: ${JSON.stringify(fallbackError)}`);
+          });
+        } else {
+          Logger.error(ORIENTATION_TAG, `setPreferredOrientation ${orientation} failed: ${JSON.stringify(error)}`);
+        }
+      });
+    } catch (e) {
+      Logger.error(ORIENTATION_TAG, `setMainWindowOrientation exception: ${JSON.stringify(e)}`);
+    }
+  }
 }
