@@ -0,0 +1,89 @@
+import { display, window } from '@kit.ArkUI';
+import { abilityDelegatorRegistry, Driver } from '@kit.TestKit';
+import { common, Want } from '@kit.AbilityKit';
+
+export class TestHelper {
+  private static readonly instance: TestHelper = new TestHelper();
+
+  static async prepareAbility(driver: Driver) {
+    const bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+    const want: Want = {
+      bundleName: bundleName,
+      abilityName: 'PhoneAbility',
+    };
+    const delegator: abilityDelegatorRegistry.AbilityDelegator = abilityDelegatorRegistry.getAbilityDelegator();
+
+    await delegator.startAbility(want);
+    await driver.waitForIdle(4000, 5000);
+  }
+
+  static getInstance(): TestHelper {
+    return TestHelper.instance;
+  }
+
+  getDisplayInfo(): display.Display {
+    return display.getDefaultDisplaySync();
+  }
+
+  getScreenWidthPx(): number {
+    let displayInfo: display.Display = this.getDisplayInfo();
+    return displayInfo.width;
+  }
+
+  getScreenHeightPx(): number {
+    let displayInfo: display.Display = this.getDisplayInfo();
+    return displayInfo.height;
+  }
+
+  getScreenDensity(): number {
+    let displayInfo: display.Display = this.getDisplayInfo();
+    return displayInfo.densityPixels;
+  }
+
+  px2vp(px: number): number {
+    let density: number = this.getScreenDensity();
+    if (density <= 0) {
+      return 0;
+    }
+    return px / density;
+  }
+
+  vp2px(vp: number): number {
+    let density: number = this.getScreenDensity();
+    return vp * density;
+  }
+
+  getScreenWidthVp(): number {
+    let widthPx: number = this.getScreenWidthPx();
+    return this.px2vp(widthPx);
+  }
+
+  getScreenHeightVp(): number {
+    let heightPx: number = this.getScreenHeightPx();
+    return this.px2vp(heightPx);
+  }
+
+  isSmallBreakpoint(vpThreshold?: number): boolean {
+    let widthVp: number = this.getScreenWidthVp();
+    let threshold: number = vpThreshold ?? 600;
+    return widthVp < threshold;
+  }
+
+  isMediumBreakpoint(vpThreshold?: number): boolean {
+    let widthVp: number = this.getScreenWidthVp();
+    let threshold: number = vpThreshold ?? 840;
+    return widthVp < threshold;
+  }
+
+  getBreakpoint(): string {
+    let widthVp: number = this.getScreenWidthVp();
+    if (widthVp < 600) {
+      return 'sm';
+    } else if (widthVp < 840) {
+      return 'md';
+    } else if (widthVp < 1440) {
+      return 'lg';
+    }
+    return 'xl';
+  }
+}
