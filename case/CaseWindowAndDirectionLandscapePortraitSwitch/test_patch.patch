+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { beforeAll, describe, expect, it } from '@ohos/hypium';
+import { window } from '@kit.ArkUI';
+import { common } from '@kit.AbilityKit';
+import { Driver, ON } from '@kit.TestKit';
+import { TestHelper } from './TestHelper';
+
+const helper = new TestHelper();
+
+export default function lgFailToPassTest() {
+  describe('LgFailToPassTest', () => {
+    let driver = Driver.create();
+    let windowClass: window.Window | null = null;
+
+    beforeAll(async () => {
+      await TestHelper.prepareAbility(driver);
+
+      try {
+        let context = getContext() as common.UIAbilityContext;
+
+        windowClass = await window.getLastWindow(context);
+
+        await driver.setDisplayRotationEnabled(true);
+      } catch (err) {
+        hilog.error(0x0000, 'testTag', 'beforeAll error: %{public}s', JSON.stringify(err));
+      }
+    });
+
+    it('should_MD_LG_device_follow_desktop_enables_rotation', 0, (done: Function) => {
+      let orientation = windowClass!.getPreferredOrientation();
+      expect(orientation).assertEqual(window.Orientation.FOLLOW_DESKTOP);
+      done();
+    });
+
+    it('should_landscape_on_LG_devices', 0, async (done: Function) => {
+      const screenH = helper.getScreenHeightPx();
+
+      const screenW = helper.getScreenWidthPx();
+
+      const swiper = await driver.waitForComponent(ON.id('video_swiper'), 5000);
+
+      await swiper.click();
+
+      await driver.delayMs(1000);
+
+      const xComponent = await driver.waitForComponent(ON.id('XComponent01'), 5000);
+
+      const afterXComponentBound = await xComponent.getBounds();
+
+      const isRightWelt = afterXComponentBound.right === screenW;
+
+      const isBottomWelt = afterXComponentBound.bottom === screenH;
+
+      expect(isRightWelt && isBottomWelt).assertTrue();
+
+      done();
+    });
+  });
+}
