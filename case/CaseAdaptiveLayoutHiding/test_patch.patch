+import { describe, beforeAll, afterAll, it } from '@ohos/hypium';
+import { Driver } from '@kit.TestKit';
+import {
+  launchApp,
+  enterScenario,
+  ScenarioExpectation,
+  verifyCurrentDevice,
+  verifyCurrentDeviceStableLayout,
+  expectHiddenOrZeroSize,
+  expectVisibleInContainer,
+  detectDeviceStage,
+  failTest
+} from './HiddenCapabilityTestUtils';
+
+const TRIP_RENDER_ORDER: string[] = [
+  'trip-security',
+  'trip-gate',
+  'trip-boarding',
+  'trip-cabin',
+  'trip-destination',
+  'trip-baggage',
+  'trip-checkin',
+  'trip-parking',
+  'trip-shop',
+  'trip-lounge',
+  'trip-pickup',
+  'trip-taxi',
+  'trip-metro',
+  'trip-hotel',
+  'trip-checkin-hotel',
+  'trip-receipt',
+  'trip-weather',
+  'trip-service-map',
+  'trip-delay-notice',
+  'trip-meal',
+  'trip-wifi',
+  'trip-reminder',
+  'trip-customer-service'
+];
+
+const tripScenario: ScenarioExpectation = {
+  homeButtonId: 'home-trip-button',
+  pageId: 'trip-page',
+  containerId: 'trip-progress',
+  layoutItemIds: TRIP_RENDER_ORDER,
+  stages: [
+    {
+      stage: 'phone',
+      visible: ['trip-security', 'trip-gate', 'trip-boarding', 'trip-destination'],
+      hidden: ['trip-cabin', 'trip-baggage', 'trip-checkin', 'trip-parking', 'trip-shop', 'trip-lounge', 'trip-pickup', 'trip-taxi', 'trip-metro', 'trip-hotel', 'trip-checkin-hotel', 'trip-receipt', 'trip-weather', 'trip-service-map', 'trip-delay-notice', 'trip-meal', 'trip-wifi', 'trip-reminder', 'trip-customer-service']
