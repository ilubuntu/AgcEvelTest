+    {
+      stage: 'foldable',
+      visible: ['trip-security', 'trip-gate', 'trip-boarding', 'trip-cabin', 'trip-destination', 'trip-baggage', 'trip-checkin', 'trip-parking'],
+      hidden: ['trip-shop', 'trip-lounge', 'trip-pickup', 'trip-taxi', 'trip-metro', 'trip-hotel', 'trip-checkin-hotel', 'trip-receipt', 'trip-weather', 'trip-service-map', 'trip-delay-notice', 'trip-meal', 'trip-wifi', 'trip-reminder', 'trip-customer-service']
+    },
+    {
+      stage: 'tablet',
+      visible: ['trip-security', 'trip-gate', 'trip-boarding', 'trip-cabin', 'trip-destination', 'trip-baggage', 'trip-checkin', 'trip-parking', 'trip-shop', 'trip-lounge'],
+      hidden: ['trip-pickup', 'trip-taxi', 'trip-metro', 'trip-hotel', 'trip-checkin-hotel', 'trip-receipt', 'trip-weather', 'trip-service-map', 'trip-delay-notice', 'trip-meal', 'trip-wifi', 'trip-reminder', 'trip-customer-service']
+    }
+  ]
+};
+
+async function expectTripArrowVisibility(driver: Driver, visibleItems: string[]): Promise<void> {
+  for (let i = 0; i < TRIP_RENDER_ORDER.length - 1; i++) {
+    const current = TRIP_RENDER_ORDER[i];
+    const next = TRIP_RENDER_ORDER[i + 1];
+    const arrowId = `${current}-arrow`;
+    const shouldBeVisible = visibleItems.indexOf(current) >= 0 && visibleItems.indexOf(next) >= 0;
+    if (shouldBeVisible) {
+      await expectVisibleInContainer(driver, arrowId, tripScenario.containerId);
+    } else {
+      await expectHiddenOrZeroSize(driver, arrowId);
+    }
+  }
+}
+
+export default function tripHiddenCapabilityTest() {
+  describe('TripScenario', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        driver = Driver.create();
+        await launchApp(driver);
+        await enterScenario(driver, tripScenario.homeButtonId, tripScenario.pageId);
+      } catch (error) {
+        failTest(error);
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        await driver.pressBack();
+        await driver.waitForIdle(600, 3000);
+      } catch (error) {
+        failTest(error);
+      }
+    });
+
+    it('should_keep_trip_nodes_on_current_device', 0, async () => {
+      try {
+        await verifyCurrentDevice(driver, tripScenario);
+        const currentStage = detectDeviceStage();
+        const expectation = tripScenario.stages.find(e => e.stage === currentStage);
+        if (expectation !== undefined) {
+          await expectTripArrowVisibility(driver, expectation.visible);
+        }
+      } catch (error) {
+        failTest(error);
+      }
+    });
+
+    it('should_keep_trip_nodes_layout_stable_on_current_device', 0, async () => {
+      try {
+        await verifyCurrentDeviceStableLayout(driver, tripScenario);
+      } catch (error) {
+        failTest(error);
+      }
+    });
+  });
+}
