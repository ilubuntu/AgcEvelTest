+  'cabin', 'baggage', 'checkin', 'parking', 'shop', 'lounge', 'pickup'
+];
+
+function visibilityWeightForNode(nodeId: string): number {
+  const index = TRIP_KEEP_ORDER.indexOf(nodeId);
+  if (index < 0) {
+    return VISIBILITY_WEIGHT_BASE;
+  }
+  return TRIP_KEEP_ORDER.length - index;
+}
