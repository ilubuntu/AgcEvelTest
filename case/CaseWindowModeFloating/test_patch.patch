@@ -0,0 +1,83 @@
+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  startAbility,
+  enterFloatWindow,
+  exitFloatWindow,
+  getWindowViewBounds,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  clickIfExists,
+  waitAndClick,
+  waitForComponent,
+  Fid,
+} from './FloatTestHelper';
+
+/**
+ * FLOAT_02 第一个（竖屏）视频进悬浮窗：视频宽高比 < 1，悬浮窗竖屏（pass_to_pass）
+ */
+export default function floatVideoPortraitTest() {
+  describe('FloatVideoPortrait', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('FLOAT_02');
+        driver = Driver.create();
+        await startAbility(driver, getBundleName(), 'PhoneAbility');
+        await driver.delayMs(600);
+        await clickIfExists(driver, ON.text('视频'), '视频tab');
+        await driver.delayMs(1500);
+        await waitAndClick(driver, ON.text('全屏播放'), '第1个视频全屏播放', 4, 500);
+        await waitForComponent(driver, ON.id(Fid.LANDSCAPE_XCOMPONENT), '横屏页视频画面', 4, 500);
+        await enterFloatWindow(driver);
+        await driver.delayMs(1000);
+      } catch (e) {
+        err('FloatVideoPortrait beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('FLOAT_02');
+        await exitFloatWindow(driver);
+        await driver.pressBack();
+      } catch (e) {
+        err('FloatVideoPortrait afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_portrait_video_float_in_portrait_window', Level.LEVEL1, async (done: Function) => {
+      try {
+        const video = await waitForComponent(driver, ON.id(Fid.LANDSCAPE_XCOMPONENT), '视频画面', 4, 500);
+        dbg(`FLOAT_02: video=${video ? JSON.stringify(video) : 'null'}`);
+        if (video === null) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const vw = video.right - video.left;
+        const vh = video.bottom - video.top;
+        dbg(`FLOAT_02: 视频画面 ${vw}x${vh} ratio=${vw / vh}`);
+        expect(vw / vh < 1).assertTrue();
+
+        const win = await getWindowViewBounds(driver);
+        dbg(`FLOAT_02: win=${win ? JSON.stringify(win) : 'null'}`);
+        if (win === null) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        dbg(`FLOAT_02: 悬浮窗 ${win.right - win.left}x${win.bottom - win.top} ratio=${(win.right - win.left) / (win.bottom - win.top)}`);
+        expect((win.right - win.left) / (win.bottom - win.top) < 1).assertTrue();
+      } catch (e) {
+        err('FLOAT_02 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
