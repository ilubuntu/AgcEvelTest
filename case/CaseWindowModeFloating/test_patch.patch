@@ -0,0 +1,116 @@
+import { describe, beforeAll, afterAll, it, expect, Level } from '@ohos/hypium';
+import {
+  Driver,
+  ON,
+  UiDirection,
+  startAbility,
+  enterFloatWindow,
+  exitFloatWindow,
+  getUiWindow,
+  getWindowViewBounds,
+  getBundleName,
+  setCaseTag,
+  dbg,
+  err,
+  clickIfExists,
+  waitAndClick,
+  waitForComponent,
+  Bounds,
+  Fid,
+} from './FloatTestHelper';
+
+/**
+ * FLOAT_03 第二个（横屏）视频进悬浮窗：视频宽高比 > 1，悬浮窗横屏（pass_to_pass）
+ */
+export default function floatVideoLandscapeTest() {
+  describe('FloatVideoLandscape', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      try {
+        setCaseTag('FLOAT_03');
+        driver = Driver.create();
+        await startAbility(driver, getBundleName(), 'PhoneAbility');
+        await driver.delayMs(600);
+        await clickIfExists(driver, ON.text('视频'), '视频tab');
+        await driver.delayMs(1000);
+        await flingNextVideo(driver);
+        await waitAndClick(driver, ON.text('全屏播放'), '第2个视频全屏播放', 4, 500);
+        await waitForComponent(driver, ON.id(Fid.LANDSCAPE_XCOMPONENT), '横屏页视频画面', 4, 500);
+        await enterFloatWindow(driver);
+        await driver.delayMs(1000);
+      } catch (e) {
+        err('FloatVideoLandscape beforeAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    afterAll(async () => {
+      try {
+        setCaseTag('FLOAT_03');
+        await exitFloatWindow(driver);
+        await driver.pressBack();
+      } catch (e) {
+        err('FloatVideoLandscape afterAll error: ' + JSON.stringify(e));
+      }
+    });
+
+    it('should_landscape_video_float_in_landscape_window', Level.LEVEL1, async (done: Function) => {
+      try {
+        const video = await waitForComponent(driver, ON.id(Fid.LANDSCAPE_XCOMPONENT), '视频画面', 4, 500);
+        dbg(`FLOAT_03: video=${video ? JSON.stringify(video) : 'null'}`);
+        if (video === null) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        const vw = video.right - video.left;
+        const vh = video.bottom - video.top;
+        dbg(`FLOAT_03: 视频画面 ${vw}x${vh} ratio=${vw / vh}`);
+        expect(vw / vh > 1).assertTrue();
+
+        const win = await getWindowViewBounds(driver);
+        dbg(`FLOAT_03: win=${win ? JSON.stringify(win) : 'null'}`);
+        if (win === null) {
+          expect(false).assertTrue();
+          done();
+          return;
+        }
+        dbg(`FLOAT_03: 悬浮窗 ${win.right - win.left}x${win.bottom - win.top} ratio=${(win.right - win.left) / (win.bottom - win.top)}`);
+        expect((win.right - win.left) / (win.bottom - win.top) > 1).assertTrue();
+      } catch (e) {
+        err('FLOAT_03 test error: ' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    });
+  });
+}
+
+/** 上滑切换到下一个视频（垂直 Swiper） */
+async function flingNextVideo(driver: Driver): Promise<void> {
+  const win = await getUiWindow(driver);
+  if (win === null) {
+    try {
+      await driver.fling(UiDirection.UP, 600);
+    } catch (e) {
+      dbg(`flingNextVideo: fling 失败: ${(e as Error).message}`);
+    }
+    return;
+  }
+  try {
+    const b = await win.getBounds() as Bounds;
+    const cx = Math.floor((b.left + b.right) / 2);
+    const h = b.bottom - b.top;
+    const startY = Math.floor(b.top + h * 0.85);
+    const endY = Math.floor(b.top + h * 0.15);
+    dbg(`flingNextVideo: swipe (${cx},${startY})→(${cx},${endY})`);
+    await driver.swipe(cx, startY, cx, endY, 3000);
+  } catch (e) {
+    dbg(`flingNextVideo: swipe 失败: ${(e as Error).message}`);
+    try {
+      await driver.fling(UiDirection.UP, 600);
+    } catch (e2) {
+      dbg(`flingNextVideo: fling 失败: ${(e2 as Error).message}`);
+    }
+  }
+}
