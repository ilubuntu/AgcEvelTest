+import { afterAll, beforeAll, describe, expect, it, Level } from '@ohos/hypium';
+import { abilityDelegatorRegistry, Driver, ON } from '@kit.TestKit';
+import { JSON } from '@kit.ArkTS';
+import { getComponentBounds, getComponentWidth, navigateToPage, startAbility } from './TestHelper';
+import { MAIN_MENU_IDS_EQUAL, ORDER_TAB_IDS_EQUAL } from '../../../main/ets/common/Models';
+
+export default function commonPassToPassTest() {
+  describe('CommonPassToPassTest', () => {
+    let driver: Driver;
+    let bundleName: string;
+
+    beforeAll(async () => {
+      try {
+        driver = Driver.create();
+        bundleName = abilityDelegatorRegistry.getArguments().bundleName;
+        await startAbility(driver, bundleName, 'EntryAbility')
+      } catch (e) {
+        console.error('CommonPassToPassTest beforeAll error' + JSON.stringify(e));
+      }
+    })
+
+    afterAll(async () => {
+      try {
+        await driver.waitForIdle(2000, 3000);
+      } catch (e) {
+        console.error('CommonPassToPassTest afterAll error' + JSON.stringify(e));
+      }
+    })
+
+    it('should_start_ability_successfully', Level.LEVEL0, async (done: Function) => {
+      try {
+        const title = await driver.findComponent(ON.text('工具栏'));
+        expect(title !== null).assertTrue();
+        await driver.delayMs(500);
+      } catch (e) {
+        console.error('should_start_ability_successfully error' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    it('should_show_main_menu_equal_items_visible', Level.LEVEL0, async (done: Function) => {
+      try {
+        await navigateToPage(driver, '优惠券 / 我的收藏 工具栏');
+        for (const id of MAIN_MENU_IDS_EQUAL) {
+          const width = await getComponentWidth(driver, id);
+          expect(width).assertLarger(0);
+        }
+      } catch (e) {
+        console.error('should_show_main_menu_equal_items_visible error' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    it('should_keep_main_menu_no_horizontal_overflow', Level.LEVEL1, async (done: Function) => {
+      try {
+        const containerRect = await getComponentBounds(driver, 'main-menu-equal-container');
+        const lastItemRect =
+          await getComponentBounds(driver, MAIN_MENU_IDS_EQUAL[MAIN_MENU_IDS_EQUAL.length - 1]);
+        expect(lastItemRect.right <= containerRect.right).assertTrue();
+      } catch (e) {
+        console.error('should_keep_main_menu_no_horizontal_overflow error' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    it('should_show_order_equal_items_visible', Level.LEVEL0, async (done: Function) => {
+      try {
+        await driver.pressBack();
+        await driver.waitForIdle(1500, 2500);
+        await navigateToPage(driver, '我的订单 工具栏');
+        for (const id of ORDER_TAB_IDS_EQUAL) {
+          const width = await getComponentWidth(driver, id);
+          expect(width).assertLarger(0);
+        }
+      } catch (e) {
+        console.error('should_show_order_equal_items_visible error' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+
+    it('should_keep_order_no_horizontal_overflow', Level.LEVEL1, async (done: Function) => {
+      try {
+        const containerRect = await getComponentBounds(driver, 'order-equal-container');
+        const lastItemRect =
+          await getComponentBounds(driver, ORDER_TAB_IDS_EQUAL[ORDER_TAB_IDS_EQUAL.length - 1]);
+        expect(lastItemRect.right <= containerRect.right).assertTrue();
+      } catch (e) {
+        console.error('should_keep_order_no_horizontal_overflow error' + JSON.stringify(e));
+        expect(false).assertTrue();
+      }
+      done();
+    })
+  })
+}
