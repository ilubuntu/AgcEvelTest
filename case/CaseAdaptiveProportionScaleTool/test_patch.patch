diff --git a/entry/src/ohosTest/ets/test/TestHelper.ets b/entry/src/ohosTest/ets/test/TestHelper.ets
new file mode 100644
index 0000000..f499d74
--- /dev/null
+++ b/entry/src/ohosTest/ets/test/TestHelper.ets
@@ -0,0 +1,118 @@
+import { Want } from '@kit.AbilityKit';
+import { abilityDelegatorRegistry, Driver, ON, ResizeDirection, UiWindow } from '@kit.TestKit';
+import { expect } from '@ohos/hypium';
+import { JSON } from '@kit.ArkTS';
+import { MAIN_MENU_IDS_EQUAL, ORDER_TAB_IDS_EQUAL } from '../../../main/ets/common/Models';
+
+export const BREAKPOINT_SM = 600;
+
+export const BREAKPOINT_MD = 840;
+
+export const BREAKPOINT_LG = 1440;
+
+export const RATIO_TOLERANCE = 0.05;
+
+export const MAIN_MENU_COUNT = 4;
+
+export const MAIN_MENU_RATIO = 1 / MAIN_MENU_COUNT;
+
+export const ORDER_TAB_COUNT = 5;
+
+export const ORDER_TAB_RATIO = 1 / ORDER_TAB_COUNT;
+
+export interface Rect {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+export async function startAbility(driver: Driver, bundleName: string, abilityName: string): Promise<void> {
+  const want: Want = {
+    bundleName: bundleName,
+    abilityName: abilityName
+  }
+  await abilityDelegatorRegistry.getAbilityDelegator().startAbility(want);
+  await driver.waitForIdle(2000, 3000);
+}
+
+export async function getComponentBounds(driver: Driver, id: string): Promise<Rect> {
+  const component = await driver.findComponent(ON.id(id));
+  expect(component !== null).assertTrue();
+  const bounds = await component.getBounds();
+  return {
+    left: bounds.left,
+    top: bounds.top,
+    right: bounds.right,
+    bottom: bounds.bottom,
+  };
+}
+
+export async function getComponentWidth(driver: Driver, id: string): Promise<number> {
+  const rect = await getComponentBounds(driver, id);
+  return rect.right - rect.left;
+}
+
+export function getBreakpointName(vpWidth: number): string {
+  if (vpWidth < BREAKPOINT_SM) {
+    return 'sm';
+  } else if (vpWidth < BREAKPOINT_MD) {
+    return 'md';
+  } else if (vpWidth < BREAKPOINT_LG) {
+    return 'lg';
+  } else {
+    return 'xl';
+  }
+}
+
+export async function getWindowVpWidth(driver: Driver, bundleName: string): Promise<number> {
+  const win = await driver.findWindow({ bundleName: bundleName, active: true });
+  const bounds = await win.getBounds();
+  return px2vp(bounds.right - bounds.left);
+}
+
+export async function navigateToPage(driver: Driver, btnText: string): Promise<void> {
+  const btn = await driver.findComponent(ON.text(btnText));
+  expect(btn !== null).assertTrue();
+  await btn.click();
+  await driver.waitForIdle(1500, 2500);
+}
+
+export async function resizeToBreakPoint(
+  driver: Driver,
+  window: UiWindow,
+  targetVpWidth: number): Promise<void> {
+  try {
+    const bounds = await window.getBounds();
+    const screenHeightPx = bounds.bottom - bounds.top;
+    const targetWidthPx = Math.round(vp2px(targetVpWidth));
+    await window.resize(targetWidthPx, screenHeightPx, ResizeDirection.RIGHT);
+    await driver.waitForIdle(2000, 3000);
+  } catch (e) {
+    console.error('TestHelper: Failed to resize window, error:' + JSON.stringify(e));
+  }
+}
+
+// 等分版验证：每项 ≈ 1/N，占满容器，相邻项比 ≈ 1
+export async function verifyEqualShare(
+  driver: Driver,
+  containerId: string,
+  itemIds: string[],
+  expectedRatio: number): Promise<void> {
+  const containerWidth = await getComponentWidth(driver, containerId);
+  expect(containerWidth).assertLarger(0);
+
+  const widths: number[] = [];
+  for (const id of itemIds) {
+    const w = await getComponentWidth(driver, id);
+    expect(w).assertLarger(0);
+    widths.push(w);
+    const ratio = w / containerWidth;
+    expect(Math.abs(ratio - expectedRatio) <= RATIO_TOLERANCE).assertTrue();
+  }
+
+  for (let i = 0; i < widths.length - 1; i++) {
+    const neighborRatio = widths[i] / widths[i + 1];
+    expect(Math.abs(neighborRatio - 1) <= RATIO_TOLERANCE).assertTrue();
+  }
+}
