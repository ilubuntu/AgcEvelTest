@@ -0,0 +1,109 @@
+import { Driver, ON, Component, UiWindow } from '@kit.TestKit';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import Want from '@ohos.app.ability.Want';
+
+export function px2vp(px: number): number {
+  return px / 3;
+}
+
+const APP_BUNDLE_NAME: string = 'harmony_0919.huawei.myapplication';
+const APP_ENTRY_ABILITY: string = 'EntryAbility';
+
+export const BREAKPOINT_SM = 600;
+export const BREAKPOINT_MD = 840;
+export const BREAKPOINT_LG = 1440;
+
+export function getBreakpointName(vpWidth: number): string {
+  if (vpWidth < BREAKPOINT_SM) {
+    return 'sm';
+  } else if (vpWidth < BREAKPOINT_MD) {
+    return 'md';
+  } else if (vpWidth < BREAKPOINT_LG) {
+    return 'lg';
+  } else {
+    return 'xl';
+  }
+}
+
+export async function getWindowVpWidth(driver: Driver, bundleName: string): Promise<number> {
+  try {
+    const window: UiWindow = await driver.findWindow({ bundleName: bundleName, active: true });
+    const bounds = await window.getBounds();
+    const windowWidthPx = bounds.right - bounds.left;
+    return px2vp(windowWidthPx);
+  } catch (e) {
+    console.error('TestHelper: Failed to get window vp width, error: ' + JSON.stringify(e));
+    return -1;
+  }
+}
+
+export interface BoundsRect {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+export async function findComponentById(driver: Driver, id: string): Promise<Component | null> {
+  try {
+    return await driver.findComponent(ON.id(id));
+  } catch (error) {
+    return null;
+  }
+}
+
+export function widthOf(bounds: BoundsRect): number {
+  return bounds.right - bounds.left;
+}
+
+export function heightOf(bounds: BoundsRect): number {
+  return bounds.bottom - bounds.top;
+}
+
+export async function findComponentInHome(driver: Driver, targetId: string): Promise<void> {
+  const delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  const want: Want = {
+    bundleName: APP_BUNDLE_NAME,
+    abilityName: APP_ENTRY_ABILITY
+  };
+  try {
+    const window: UiWindow = await driver.findWindow({ bundleName: APP_BUNDLE_NAME, active: true });
+    if (window) {
+      await driver.pressBack();
+      await driver.waitForIdle(500, 2000);
+    }
+  } catch (e) {
+  }
+  await delegator.startAbility(want);
+  await driver.waitForIdle(2000, 8000);
+  let retryCount = 0;
+  const maxRetries = 10;
+  while (retryCount < maxRetries) {
+    try {
+      await driver.assertComponentExist(ON.id('home-page'));
+      break;
+    } catch (e) {
+      if (retryCount === maxRetries - 1) {
+        throw new Error('home-page component not found after ' + maxRetries + ' retries');
+      }
+      await driver.waitForIdle(500, 2000);
+      retryCount++;
+    }
+  }
+  await driver.waitForIdle(500, 3000);
+  retryCount = 0;
+  while (retryCount < maxRetries) {
+    try {
+      await driver.assertComponentExist(ON.id(targetId));
+      break;
+    } catch (e) {
+      if (retryCount === maxRetries - 1) {
+        throw new Error(targetId + ' component not found after ' + maxRetries + ' retries');
+      }
+      await driver.waitForIdle(500, 2000);
+      retryCount++;
+    }
+  }
+  await driver.waitForIdle(300, 2000);
+}
+
