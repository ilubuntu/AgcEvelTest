+import { describe, beforeAll, afterEach, it, expect } from '@ohos/hypium';
+import { Driver, Component } from '@kit.TestKit';
+import { findComponentInHome, getWindowVpWidth, getBreakpointName, findComponentById, BoundsRect, widthOf, px2vp } from './TestUtils';
+
+const BUNDLE_NAME = 'harmony_0919.huawei.myapplication';
+
+export default function lgFailToPassTest() {
+  describe('LgFailToPassTest', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+    });
+
+    afterEach(async () => {
+      await driver.pressBack();
+      await driver.waitForIdle(600, 3000);
+    });
+    // 断言首页搜索框在lg断点下自适应父容器尺寸变化
+    it('should_search_input_adaptive_on_lg_breakpoint', 0, async () => {
+      await findComponentInHome(driver, 'search-input');
+      const windowWidth = await getWindowVpWidth(driver, BUNDLE_NAME);
+      const bp = getBreakpointName(windowWidth);
+      expect(bp).assertEqual('lg');
+      const searchInput = await findComponentById(driver, 'search-input');
+      expect(searchInput !== null).assertTrue();
+      const searchBounds = await (searchInput as Component).getBounds() as BoundsRect;
+      const searchWidthVp = px2vp(widthOf(searchBounds));
+      const ratio =searchWidthVp / windowWidth;
+      expect(ratio > 0.8 && ratio <= 1).assertTrue();
+    });
+    // 断言首页签到卡片在lg断点下自适应父容器尺寸变化
+    it('should_card_checkin_adaptive_on_lg_breakpoint', 0, async () => {
+      await findComponentInHome(driver, 'card-checkin');
+      const windowWidth = await getWindowVpWidth(driver, BUNDLE_NAME);
+      const bp = getBreakpointName(windowWidth);
+      expect(bp).assertEqual('lg');
+      const cardCheckin = await findComponentById(driver, 'card-checkin');
+      expect(cardCheckin !== null).assertTrue();
+      const cardBounds = await (cardCheckin as Component).getBounds() as BoundsRect;
+      const cardWidthVp = px2vp(widthOf(cardBounds));
+      const ratio = cardWidthVp / windowWidth;
+      expect(ratio > 0.3 && ratio <= 0.5).assertTrue();
+    });
+    // 断言首页秒杀卡片在lg断点下自适应父容器尺寸变化
+    it('should_card_seckill_adaptive_on_lg_breakpoint', 0, async () => {
+      await findComponentInHome(driver, 'card-seckill');
+      const windowWidth = await getWindowVpWidth(driver, BUNDLE_NAME);
+      const bp = getBreakpointName(windowWidth);
+      expect(bp).assertEqual('lg');
+      const cardSeckill = await findComponentById(driver, 'card-seckill');
+      expect(cardSeckill !== null).assertTrue();
+      const cardBounds = await (cardSeckill as Component).getBounds() as BoundsRect;
+      const cardWidthVp = px2vp(widthOf(cardBounds));
+      const ratio = cardWidthVp / windowWidth;
+      expect(ratio > 0.3 && ratio <= 0.6).assertTrue();
+    });
+  });
+}
