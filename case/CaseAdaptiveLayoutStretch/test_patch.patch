+import { describe, beforeAll, afterEach, it, expect } from '@ohos/hypium';
+import { Driver } from '@kit.TestKit';
+import { findComponentInHome, findComponentById } from './TestUtils';
+
+export default function commonPassToPassTest() {
+  describe('CommonPassToPassTest', () => {
+    let driver: Driver;
+
+    beforeAll(async () => {
+      driver = Driver.create();
+    });
+
+    afterEach(async () => {
+      await driver.pressBack();
+      await driver.waitForIdle(600, 3000);
+    });
+    // 断言商品首页存在
+    it('should_show_home_page', 0, async () => {
+      await findComponentInHome(driver, 'home-page');
+      const homePage = await findComponentById(driver, 'home-page');
+      expect(homePage !== null).assertTrue();
+    });
+    // 断言商品首页搜索框存在
+    it('should_show_search_input', 0, async () => {
+      await findComponentInHome(driver, 'home-page');
+      const searchInput = await findComponentById(driver, 'search-input');
+      expect(searchInput !== null).assertTrue();
+    });
+    // 断言商品首页签到、秒杀存在
+    it('should_show_card_area', 0, async () => {
+      await findComponentInHome(driver, 'home-page');
+      const cardArea = await findComponentById(driver, 'card-area');
+      expect(cardArea !== null).assertTrue();
+    });
+  });
+}
